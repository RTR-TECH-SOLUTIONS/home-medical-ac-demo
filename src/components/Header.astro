---
import Logo from './Logo.astro';
import { nav, site, whatsapp, url } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === (url(href).replace(/\/+$/, '') || '/');
---

<header class="site-header fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex h-20 max-w-6xl items-center justify-between px-5 md:px-8">
    <a href={url('/')} class="flex items-center gap-3">
      <Logo class="h-9 w-9 shrink-0" />
      <span class="text-[1.05rem] font-semibold tracking-tight leading-none">
        {site.name}
        <span class="mt-1 block text-[0.7rem] font-medium tracking-normal opacity-75">
          {site.tagline}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium lg:flex" aria-label="Navigație principală">
      {
        nav.map((item) => (
          <a
            href={url(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'transition-opacity hover:opacity-100',
              isActive(item.href)
                ? 'underline decoration-2 underline-offset-8 opacity-100'
                : 'opacity-90',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href={site.phoneHref} class="text-sm font-semibold tabular-nums">{site.phone}</a>
      <a
        href={whatsapp()}
        target="_blank"
        rel="noopener"
        class="rounded-[10px] bg-red px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-red-dark"
      >
        Programează pe WhatsApp
      </a>
    </div>

    <button
      type="button"
      class="menu-toggle -mr-2 flex h-11 w-11 items-center justify-center lg:hidden"
      aria-label="Deschide meniul"
      aria-expanded="false"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path class="icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="icon-close hidden" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <div class="mobile-menu hidden max-h-[calc(100svh-5rem)] overflow-y-auto border-t border-line bg-bg text-ink lg:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col px-5 py-4" aria-label="Navigație mobilă">
      {
        nav.map((item) => (
          <a
            href={url(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'border-b border-line py-3.5 text-[0.95rem] last:border-0',
              isActive(item.href) ? 'font-semibold text-red' : 'font-medium',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-4 flex flex-col gap-3 pb-2">
        <a
          href={whatsapp()}
          target="_blank"
          rel="noopener"
          class="rounded-[10px] bg-red px-4 py-3 text-center text-sm font-semibold text-white"
        >
          Programează pe WhatsApp
        </a>
        <a href={site.phoneHref} class="rounded-[10px] border border-line px-4 py-3 text-center text-sm font-semibold">
          Sunați: {site.phone}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.menu-toggle');
  const menu = header?.querySelector('.mobile-menu');

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Închide meniul' : 'Deschide meniul');
    toggle?.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle?.querySelector('.icon-close')?.classList.toggle('hidden', !open);
    // Meniul deschis are fundal solid, deci header-ul trece pe varianta solidă
    header?.classList.toggle('menu-open', open);
    if (open) header?.classList.add('is-solid');
    else if (window.scrollY <= 24) header?.classList.remove('is-solid');
  };

  toggle?.addEventListener('click', () => setMenu(menu?.classList.contains('hidden') === true));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('hidden') === false) setMenu(false);
  });
</script>

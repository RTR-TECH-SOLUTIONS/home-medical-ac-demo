---
import Logo from './Logo.astro';
import { nav, legal, site, whatsapp, url } from '../data/site';
import { services } from '../data/services';
---

<footer class="border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-[1.3fr_1fr_1fr] md:px-8">
    <div class="max-w-sm">
      <div class="flex items-center gap-3">
        <Logo class="h-8 w-8" />
        <span class="font-semibold tracking-tight">{site.name}</span>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-body">
        Servicii medicale la domiciliu în {site.area}. Cu profesionalism și respect, echipa{' '}
        {site.name}.
      </p>
      <p class="mt-4 text-sm text-body">
        În caz de urgență medicală sunați la <strong class="font-semibold text-ink">112</strong>.
      </p>
    </div>

    <nav class="text-sm" aria-label="Pagini">
      <p class="font-serif text-base font-semibold">Pagini</p>
      <ul class="mt-3.5 flex flex-col gap-2.5">
        <li><a href={url('/')} class="text-body transition-colors hover:text-ink">Acasă</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} class="text-body transition-colors hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="text-sm">
      <p class="font-serif text-base font-semibold">Contact</p>
      <ul class="mt-3.5 flex flex-col gap-2.5">
        <li><a href={site.phoneHref} class="font-semibold">{site.phone}</a></li>
        <li class="text-body">{site.schedule}</li>
        <li>
          <a href={whatsapp()} target="_blank" rel="noopener" class="text-body transition-colors hover:text-ink">
            WhatsApp
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="break-all text-body transition-colors hover:text-ink">
            {site.email}
          </a>
        </li>
        <li>
          <a href={site.facebook} target="_blank" rel="noopener" class="text-body transition-colors hover:text-ink">
            Facebook
          </a>
        </li>
      </ul>
    </div>
  </div>

  <nav class="border-t border-line" aria-label="Servicii">
    <div class="mx-auto max-w-6xl px-5 py-6 md:px-8">
      <ul class="flex flex-wrap gap-x-6 gap-y-2.5 text-sm">
        {
          services.map((service) => (
            <li>
              <a
                href={url(`/servicii/${service.slug}`)}
                class="text-body transition-colors hover:text-ink"
              >
                {service.navTitle}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-5 text-xs text-body md:flex-row md:items-center md:justify-between md:px-8"
    >
      <p>© {new Date().getFullYear()} {site.name}. Toate drepturile rezervate.</p>
      <nav aria-label="Informații legale">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            legal.map((item) => (
              <li>
                <a href={url(item.href)} class="transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="https://rtrsolutions.ro"
              target="_blank"
              rel="noopener"
              class="transition-colors hover:text-ink"
            >
              Site realizat de RTR Tech Solutions
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

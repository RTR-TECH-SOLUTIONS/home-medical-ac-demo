---
import { url } from '../data/site';
const steps = [
  {
    title: 'Obțineți recomandarea',
    text: 'Medicul de familie sau medicul specialist eliberează recomandarea pentru îngrijiri medicale la domiciliu, la externare sau la consult.',
  },
  {
    title: 'Ne ocupăm noi de dosar',
    text: 'Vă îndrumăm pas cu pas și pregătim documentele pentru Casa de Asigurări de Sănătate Constanța.',
  },
  {
    title: 'Începem vizitele acasă',
    text: 'După aprobare, echipa noastră vine la domiciliu conform planului stabilit de medic, fără niciun cost pentru pacient.',
  },
];
---

<section id="decontare" class="bg-ink text-white">
  <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
    <div class="reveal max-w-2xl">
      <h2 class="h-section">Gratuit prin CAS sau contra cost</h2>
      <p class="mt-4 text-base leading-relaxed text-white/75 md:text-lg">
        Serviciile pot fi decontate integral de Casa de Asigurări de Sănătate, în funcție
        de recomandarea medicului și de eligibilitatea pacientului. Vă spunem de la primul
        telefon în ce situație vă încadrați.
      </p>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-14">
      <div>
        <h3 class="reveal font-serif text-xl font-semibold">
          Cum obțineți serviciile gratuite, în 3 pași
        </h3>
        <ol class="mt-6 space-y-7">
          {steps.map((step, i) => (
            <li class="reveal flex gap-5">
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/25 font-serif text-lg font-semibold"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <div>
                <p class="font-semibold">{step.title}</p>
                <p class="mt-1.5 text-[0.95rem] leading-relaxed text-white/70">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <a
          href={url('/decontare-cas')}
          class="reveal mt-8 inline-block rounded-[10px] border border-white/30 px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/10"
        >
          Condiții, acte necesare și întrebări frecvente
        </a>
      </div>

      <aside class="reveal h-fit rounded-xl border border-white/15 bg-white/5 p-7">
        <h3 class="font-serif text-xl font-semibold">Fără recomandare CAS?</h3>
        <p class="mt-3 text-[0.95rem] leading-relaxed text-white/70">
          Oferim aceleași servicii și contra cost, fără dosare și fără așteptare:
          programați direct, iar tariful vizitei vi se comunică transparent la telefon,
          înainte de programare.
        </p>
        <a
          href="#contact"
          class="mt-6 inline-block rounded-[10px] bg-red px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-red-dark"
        >
          Întrebați-ne despre eligibilitate
        </a>
      </aside>
    </div>
  </div>
</section>

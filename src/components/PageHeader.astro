---
import { url } from '../data/site';
interface Props {
  title: string;
  lead?: string;
  /** Eticheta paginii curente în firul Ariadnei. */
  breadcrumb: string;
  /** Nivel intermediar, pentru paginile aflate sub o secțiune (ex. un serviciu). */
  parent?: { label: string; href: string };
}

const { title, lead, breadcrumb, parent } = Astro.props;
---

<section class="bg-ink text-white">
  <div class="mx-auto max-w-6xl px-5 pb-14 pt-32 md:px-8 md:pb-20 md:pt-36">
    <nav aria-label="Firul Ariadnei" class="text-sm text-white/60">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href={url('/')} class="transition-colors hover:text-white">Acasă</a></li>
        <li aria-hidden="true" class="text-white/35">/</li>
        {
          parent && (
            <>
              <li>
                <a href={url(parent.href)} class="transition-colors hover:text-white">
                  {parent.label}
                </a>
              </li>
              <li aria-hidden="true" class="text-white/35">
                /
              </li>
            </>
          )
        }
        <li aria-current="page" class="text-white/85">{breadcrumb}</li>
      </ol>
    </nav>
    <h1 class="h-display mt-5 max-w-3xl">{title}</h1>
    {
      lead && (
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/75 md:text-lg">{lead}</p>
      )
    }
    <div class="empty:hidden">
      <slot />
    </div>
  </div>
</section>

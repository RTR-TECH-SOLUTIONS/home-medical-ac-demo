---
import { Image } from 'astro:assets';
import mark from '../assets/media/logo-mark.png';

interface Props {
  class?: string;
}
const { class: className = 'h-9 w-9' } = Astro.props;
---

{/* Sigla reală Home Medical AC, preluată de pe pagina de Facebook a clientei.
    Discul alb ține sigla lizibilă și peste header-ul transparent de pe hero. */}
<span
  class:list={['inline-flex shrink-0 items-center justify-center rounded-full bg-white', className]}
>
  <Image
    src={mark}
    alt=""
    width={90}
    height={91}
    densities={[1, 2]}
    class="h-[82%] w-[82%] object-contain"
    aria-hidden="true"
  />
</span>

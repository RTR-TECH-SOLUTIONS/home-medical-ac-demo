---
import { url } from '../data/site';
import { Image } from 'astro:assets';
import { featuredServices, otherServices } from '../data/services';
---

<section id="servicii" class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
  <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <h2 class="h-section">Serviciile noastre, la domiciliul pacientului</h2>
      <p class="lead mt-4">
        Tot ce se poate face în ambulatoriu, adus acasă la pacient. În plus, oferim servicii
        personalizate în funcție de nevoile fiecăruia și de recomandarea medicului.
      </p>
    </div>
    <a
      href={url('/servicii')}
      class="shrink-0 rounded-[10px] border border-ink/20 px-5 py-3 text-sm font-semibold transition-colors hover:border-ink/40"
    >
      Vezi toate serviciile
    </a>
  </div>

  <div class="mt-12 grid gap-6 md:grid-cols-2">
    {
      featuredServices.map((service) => (
        <a
          href={url(`/servicii/${service.slug}`)}
          class="reveal group block overflow-hidden rounded-xl border border-line bg-surface transition-colors hover:border-ink/25"
        >
          <Image
            src={service.image}
            alt={service.alt}
            widths={[480, 760, 1100]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="aspect-[16/10] w-full object-cover"
          />
          <div class="p-6 md:p-7">
            <h3 class="h-card">{service.title}</h3>
            <p class="mt-2.5 text-[0.95rem] leading-relaxed text-body">{service.short}</p>
            <p class="mt-4 text-sm font-semibold text-red group-hover:underline">Detalii despre serviciu</p>
          </div>
        </a>
      ))
    }
  </div>

  <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      otherServices.map((service) => (
        <a
          href={url(`/servicii/${service.slug}`)}
          class="reveal group block overflow-hidden rounded-xl border border-line bg-surface transition-colors hover:border-ink/25"
        >
          <Image
            src={service.image}
            alt={service.alt}
            widths={[400, 640]}
            sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
            class="aspect-[4/3] w-full object-cover"
          />
          <div class="p-5">
            <h3 class="font-serif text-[1.05rem] font-semibold leading-snug">{service.navTitle}</h3>
            <p class="mt-2 text-sm leading-relaxed text-body">{service.short}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>

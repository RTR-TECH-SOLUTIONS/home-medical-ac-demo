---
import { url } from '../data/site';
import { getImage } from 'astro:assets';
import heroPoster from '../assets/media/hero-arrival.png';

const poster = await getImage({ src: heroPoster, format: 'webp', width: 1920, quality: 62 });
---

<section id="sus" class="relative flex min-h-[100svh] items-end overflow-hidden bg-ink text-white">
  {/*
    Video-ul nu se descarcă la încărcarea paginii: sursele sunt puse din JS, după `load`,
    doar pe ecrane mari și pe conexiuni bune. Pe telefon rămâne afișat posterul, ca să nu
    consumăm 1 MB pe date mobile și ca să nu întârziem afișarea textului.
  */}
  <video
    class="hero-video absolute inset-0 h-full w-full object-cover"
    muted
    loop
    playsinline
    preload="none"
    poster={poster.src}
    aria-hidden="true"
    data-webm={url('/media/hero.webm')}
    data-mp4={url('/media/hero.mp4')}></video>
  <div
    class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/35 to-black/25"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-full max-w-6xl px-5 pb-16 pt-36 md:px-8 md:pb-20">
    <h1 class="h-display max-w-3xl">
      Îngrijiri medicale la domiciliu, în Constanța
    </h1>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/85 md:text-lg">
      Echipa Home Medical AC vine la domiciliul pacientului, în Constanța și în tot
      județul: consultații, recoltări de analize, tratamente și îngrijiri specializate.
      Servicii decontate de CAS pentru pacienții eligibili sau contra cost.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3.5">
      <a
        href="#contact"
        class="rounded-[10px] bg-red px-6 py-3.5 text-[0.95rem] font-semibold text-white transition-colors hover:bg-red-dark"
      >
        Programează o vizită
      </a>
      <a
        href="tel:+40726390461"
        class="rounded-[10px] border border-white/40 px-6 py-3.5 text-[0.95rem] font-semibold text-white transition-colors hover:border-white/70 hover:bg-white/10"
      >
        0726 390 461
      </a>
    </div>
    <p class="mt-5 text-sm text-white/70">
      Pentru programare ne transmiteți: numele pacientului, localitatea și serviciul dorit.
    </p>
  </div>
</section>

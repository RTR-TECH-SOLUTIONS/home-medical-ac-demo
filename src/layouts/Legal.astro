---
import Layout from './Layout.astro';
import PageHeader from '../components/PageHeader.astro';

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  breadcrumb: string;
  updated: string;
  /** Paginile de politici nu aduc trafic și nu au ce căuta în index. */
  noindex?: boolean;
}

const { title, metaTitle, description, breadcrumb, updated, noindex = false } = Astro.props;
---

<Layout title={metaTitle} description={description} noindex={noindex}>
  <PageHeader title={title} breadcrumb={breadcrumb} />

  <section class="mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-20">
    <p class="text-sm text-body">Ultima actualizare: {updated}</p>
    <div class="prose-legal mt-8">
      <slot />
    </div>
  </section>
</Layout>

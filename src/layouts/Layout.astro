---
import { url } from '../data/site';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Servicii medicale la domiciliu în Constanța și zonele limitrofe: consultații, recoltări de analize, tratamente injectabile și perfuzabile, îngrijiri postoperatorii și paliative. Servicii decontate de CAS sau contra cost.',
} = Astro.props;
---

<html lang="ro">
  <head>
    <meta charset="utf-8" />
    {/* Sigla reală a clientei (preluată de pe Facebook), folosită și ca favicon. */}
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {/* Preview pentru client: nu vrem să fie indexat și confundat cu site-ul oficial.
        Se scoate la lansarea proiectului real. */}
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      href="#continut"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-[10px] focus:bg-red focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white"
    >
      Sari la conținut
    </a>
    <Header />
    <main id="continut">
      <slot />
    </main>
    <Footer />
    <script>
      // Header transparent peste banda întunecată de sus -> solid la scroll
      const header = document.querySelector('.site-header');
      const onScroll = () => {
        if (header?.classList.contains('menu-open')) return;
        header?.classList.toggle('is-solid', window.scrollY > 24);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Reveal discret la scroll
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealed = document.querySelectorAll('.reveal');
      if (reduced) {
        revealed.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        revealed.forEach((el) => io.observe(el));
      }

      // Video hero: oprit la prefers-reduced-motion
      const heroVideo = document.querySelector<HTMLVideoElement>('.hero-video');
      if (heroVideo && reduced) {
        heroVideo.removeAttribute('autoplay');
        heroVideo.pause();
      }
    </script>
  </body>
</html>

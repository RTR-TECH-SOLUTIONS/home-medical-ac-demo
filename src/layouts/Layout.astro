---
import { url, site } from '../data/site';
import { businessSchema } from '../data/schema';
import interRegular from '../assets/fonts/inter-400.woff2?url';
import serifBold from '../assets/fonts/serif-600.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieNotice from '../components/CookieNotice.astro';

interface Props {
  title: string;
  description?: string;
  /** Date structurate specifice paginii (breadcrumb, FAQ, serviciu). */
  schema?: unknown[];
  /** Pagini care nu au ce căuta în index (politici, pagini duplicat). */
  noindex?: boolean;
}

const {
  title,
  description = 'Îngrijiri medicale la domiciliu în Constanța și zonele limitrofe: consultații, recoltări de analize, perfuzii și injecții, pansamente și escare, îngrijiri postoperatorii și paliative. Servicii decontate de CAS sau contra cost.',
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/index\.html$/, ''), Astro.site).href;
const ogImage = new URL(url('/og-home-medical-ac.jpg'), Astro.site).href;
const structuredData = [businessSchema, ...schema];
---

<html lang="ro">
  <head>
    <meta charset="utf-8" />
    {/* Sigla reală a clientei (preluată de pe Facebook), folosită și ca favicon. */}
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Cele două fonturi folosite deasupra pliului: titlul serif și textul de bază. */}
    <link rel="preload" as="font" type="font/woff2" href={serifBold} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interRegular} crossorigin />

    {
      structuredData.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
  </head>
  <body>
    <a
      href="#continut"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-[10px] focus:bg-red focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white"
    >
      Sari la conținut
    </a>
    <Header />
    <main id="continut">
      <slot />
    </main>
    <Footer />
    <CookieNotice />
    <script>
      // Header transparent peste banda întunecată de sus -> solid la scroll
      const header = document.querySelector('.site-header');
      const onScroll = () => {
        if (header?.classList.contains('menu-open')) return;
        header?.classList.toggle('is-solid', window.scrollY > 24);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Reveal discret la scroll
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealed = document.querySelectorAll('.reveal');
      if (reduced) {
        revealed.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        revealed.forEach((el) => io.observe(el));
      }

      // Video hero: încărcat abia după `load`, doar pe ecrane mari și pe conexiuni bune.
      // Pe mobil, pe conexiuni lente sau la prefers-reduced-motion rămâne posterul.
      const heroVideo = document.querySelector<HTMLVideoElement>('.hero-video');
      if (heroVideo && !reduced && window.matchMedia('(min-width: 768px)').matches) {
        const conn = (navigator as any).connection;
        const stingy = conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType ?? ''));
        if (!stingy) {
          const start = () => {
            for (const [attr, type] of [
              ['webm', 'video/webm'],
              ['mp4', 'video/mp4'],
            ] as const) {
              const src = heroVideo.dataset[attr];
              if (!src) continue;
              const source = document.createElement('source');
              source.src = src;
              source.type = type;
              heroVideo.appendChild(source);
            }
            heroVideo.load();
            heroVideo.play().catch(() => {
              /* browserul poate refuza autoplay: rămâne posterul */
            });
          };
          if (document.readyState === 'complete') start();
          else window.addEventListener('load', start, { once: true });
        }
      }
    </script>
  </body>
</html>
